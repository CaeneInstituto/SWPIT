# ─── Culqi - Claves de API ──────────────────────────────────────────────────
# Copia este archivo como .env y reemplaza con tus claves reales
# Obtén tus claves en: https://integ-panel.culqi.com → Desarrollo → API Keys

# Clave PÚBLICA (va en el frontend - empieza con pk_test_ o pk_live_)
VITE_CULQI_PUBLIC_KEY=pk_test_REEMPLAZAR_CON_TU_CLAVE

# Clave SECRETA (solo en el backend - empieza con sk_test_ o sk_live_)
# ⚠️ NUNCA compartas esta clave ni la subas a Git
# Esta se configura en Vercel → Settings → Environment Variables
CULQI_SECRET_KEY=sk_test_REEMPLAZAR_CON_TU_CLAVE

# MongoDB Atlas - Conexión SRV (recomendado para producción)
# Formato: mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/database?retryWrites=true&w=majority
# Obtén tu URI en: MongoDB Atlas → Database → Connect → Connect your application
# ⚠️ NO usar formato directo mongodb:// con shards (shard-00-00, shard-00-01, etc)
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/peruintravel?retryWrites=true&w=majority

# URL del servidor backend para llamadas API
# En producción (Vercel): usar la URL de tu deployment
# En desarrollo local: usar localhost si tienes backend separado
VITE_API_URL=https://tu-proyecto.vercel.app
# Para desarrollo local descomentalo si necesitas:
# VITE_API_URL=http://localhost:3001
